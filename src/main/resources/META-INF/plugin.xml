<idea-plugin url="https://github.com/hbymrito/intellij-branch-notes">
    <id>com.github.hbymrito.branchnotes</id>
    <name>Git Branch Notes</name>
    <vendor url="https://github.com/hbymrito" email="chen062059@gmail.com">hbymrito</vendor>

    <description><![CDATA[
        Displays local Git branch notes next to local and remote branch names in IntelliJ IDEA.
        <ul>
            <li>Annotates local and remote branches in the Git Log branch dashboard.</li>
            <li>Lets you add, edit, and delete notes from native single-branch action menus.</li>
            <li>Copies a remote note once when creating a new local tracking branch.</li>
            <li>Copies a local note once when Push creates a remote branch with an exact source mapping.</li>
            <li>Optionally shows the current local branch and its note in the status bar.</li>
            <li>Stores all notes locally in the repository's Git configuration.</li>
        </ul>
        No external service or project file is required.
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li>Updates the build target to IntelliJ IDEA 2026.3.</li>
            <li>Declares the platform VCS dependency required by the modularized IDE.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.platform.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
            implementation="com.github.hbymrito.branchnotes.BranchNotesStartupActivity"/>
        <statusBarWidgetFactory
            id="GitBranchNotes"
            implementation="com.github.hbymrito.branchnotes.BranchNotesWidgetFactory"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.github.hbymrito.branchnotes.BranchNotesRefreshListener"
            topic="git4idea.repo.GitRepositoryChangeListener"/>
        <listener
            class="com.github.hbymrito.branchnotes.BranchNotesRefreshListener"
            topic="com.intellij.dvcs.repo.VcsRepositoryMappingListener"/>
        <listener
            class="com.github.hbymrito.branchnotes.BranchNotesRefreshListener"
            topic="git4idea.push.GitPushListener"/>
    </projectListeners>

    <actions>
        <group id="BranchNotes.BranchActions">
            <action
                id="BranchNotes.EditRemark"
                class="com.github.hbymrito.branchnotes.EditBranchNoteAction"/>
            <action
                id="BranchNotes.DeleteRemark"
                class="com.github.hbymrito.branchnotes.DeleteBranchNoteAction"/>
            <add-to-group group-id="Git.Branch" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
